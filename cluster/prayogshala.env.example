# Prayogshala Big Data lab — copy to cluster/prayogshala.env and adjust if IPs change
# These names are NOT in /etc/hosts; Spark and Mongo use IP addresses directly.

MASTER_IP=10.3.21.218
WORKER1_IP=10.3.23.119
WORKER2_IP=10.3.23.64

SPARK_MASTER_URL=spark://10.3.21.218:7077

# MongoDB runs on the master VM. Use the master IP (not 127.0.0.1) so Spark executors
# on slave1/slave2 can read/write collections.
MONGO_HOST=10.3.21.218
MONGO_PORT=27017
MONGO_DB=readmission

# Spark 4.1.x on your lab image
MONGO_SPARK_JAR=jars/mongo-spark-connector_2.13-11.1.0.jar

DATA_CSV=data/diabetic_data.csv
