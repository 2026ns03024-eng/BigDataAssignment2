# Two-VM cluster — copy to cluster/cluster.env and edit IPs
# Then: bash scripts/apply_cluster_env.sh

# VM1: MongoDB + Spark master + Python driver (typical)
VM1_IP=192.0.2.10
# VM2: Spark worker (typical)
VM2_IP=192.0.2.11

SPARK_MASTER_URL=spark://192.0.2.10:7077

# Mongo on VM1 — use VM1 LAN IP so VM2 executors can connect
MONGO_HOST=192.0.2.10
MONGO_PORT=27017
MONGO_DB=readmission

# Set after: bash scripts/fetch_mongo_spark_jar.sh (auto-detects Spark version)
MONGO_SPARK_JAR=jars/mongo-spark-connector_2.13-11.1.0.jar

DATA_CSV=data/diabetic_data.csv
