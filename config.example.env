# Copy to config.env on the driver VM and edit after discovery
#   bash scripts/discover_cluster.sh
# Optional IP template:
#   cp cluster/cluster.env.example cluster/cluster.env && bash scripts/apply_cluster_env.sh

# MongoDB — use a host IP reachable from all Spark executors (often driver VM IP)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=readmission

# Spark: yarn, spark://<driver-ip>:7077, or local[4] for single-VM fallback
SPARK_MASTER=spark://CHANGE_ME_DRIVER_IP:7077

# Bind Spark to the driver's reachable private interface on multi-NIC VMs
SPARK_LOCAL_IP=CHANGE_ME_DRIVER_PRIVATE_IP

# Set after fetch_mongo_spark_jar.sh (Spark 4.x example below)
MONGO_SPARK_JAR=jars/mongo-spark-connector_2.13-11.1.0.jar

# Spark 2.x only
# MONGO_SPARK_JAR=jars/mongo-spark-connector_2.11-2.4.4.jar
# USE_SPARK24_URI=1

DATA_CSV=data/diabetic_data.csv
