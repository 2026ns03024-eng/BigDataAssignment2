# Copy to config.env on the Prayogshala master node and edit values
# after running: bash scripts/discover_cluster.sh
#
# Prayogshala (no /etc/hosts aliases): use IPs — see cluster/prayogshala.env.example
#   bash scripts/apply_prayogshala_env.sh

# MongoDB on master — use master IP for Spark workers (not 127.0.0.1)
MONGO_HOST=10.3.21.218
MONGO_PORT=27017
MONGO_DB=readmission

# Spark standalone on Prayogshala (YARN usually unavailable)
SPARK_MASTER=spark://10.3.21.218:7077

# Spark 4.1.x connector (Spark 3.x: mongo-spark-connector_2.12-10.2.0.jar)
MONGO_SPARK_JAR=jars/mongo-spark-connector_2.13-11.1.0.jar

# Spark 2.x legacy keys (only if discover shows Spark 2.4)
# MONGO_SPARK_JAR=jars/mongo-spark-connector_2.11-2.4.4.jar
# USE_SPARK24_URI=1

# UCI dataset (downloaded in STEPS/05)
DATA_CSV=data/diabetic_data.csv
