# Copy to config.env on the Prayogshala master node and edit values
# after running: bash scripts/discover_cluster.sh

# MongoDB (typically on master)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=readmission

# Spark master URL (from discover script: yarn or spark://hostname:7077)
SPARK_MASTER=yarn

# Connector jar path (relative to repo root after STEPS/04)
MONGO_SPARK_JAR=jars/mongo-spark-connector_2.12-10.2.0.jar

# Spark 2.x legacy keys (only if discover shows Spark 2.4)
# MONGO_SPARK_JAR=jars/mongo-spark-connector_2.11-2.4.4.jar
# USE_SPARK24_URI=1

# UCI dataset (downloaded in STEPS/05)
DATA_CSV=data/diabetic_data.csv
